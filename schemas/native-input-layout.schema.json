{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xykal/sampdroid/schemas/native-input-layout.schema.json",
  "title": "SampDroid native Android input layout v1",
  "description": "Internal native input layout only; never loads scripts, binaries, or PC modpacks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "orientation", "safeArea", "controls"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$", "maxLength": 120 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "orientation": { "enum": ["landscape", "portrait", "any"] },
    "safeArea": { "type": "boolean" },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": { "$ref": "#/$defs/control" }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "action", "anchor", "x", "y", "size", "opacity"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
        "kind": { "enum": ["stick", "button", "trigger", "radial", "swipe-zone"] },
        "action": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
        "anchor": { "enum": ["top-start", "top-end", "bottom-start", "bottom-end", "center"] },
        "x": { "$ref": "#/$defs/unit" },
        "y": { "$ref": "#/$defs/unit" },
        "size": { "type": "number", "minimum": 0.04, "maximum": 0.5 },
        "opacity": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "hold": { "type": "boolean", "default": false },
        "label": { "type": "string", "maxLength": 24 }
      }
    }
  }
}
